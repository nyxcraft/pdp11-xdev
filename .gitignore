# Build products.  The host tools land in bin/, the per-universe target
# headers and libraries in include/ and lib/ -- all regenerated by `make`.
/bin/
/include/
/lib/
*.o
*.a

# Per-tool build intermediates
src/pdp11-c1/cvopt
src/pdp11-c1/mktab
src/pdp11-c1/table.i
src/pdp11-c1/table.c
src/pdp11-cpp/cpy.c
src/pdp11-s5fs/bin/

# apsim guest-root content is installed by mkroot.sh, not tracked
# (only the checked-in skeleton under src/pdp11-apsim/root is tracked)
src/pdp11-apsim/root/usr/games/rogue
src/pdp11-apsim/root/tmp/
src/pdp11-apsim/root/usr/tmp/

# Oracle fixtures are extracted from vintage distribution images by the
# setup scripts (copyrighted vintage binaries; regenerable) -- never tracked.
oracle/native/
oracle/work/

# Test scratch
tests/work/
__pycache__/
src/pdp11-libc/build/

# das dumps per-object listings into the cwd when run against symboled
# binaries; they are debugging work products, never tree content.
*.dis

# provenance notes: kept locally, intentionally untracked
/NOTES.md
